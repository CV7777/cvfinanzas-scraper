<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados de la Personalidad Financiera</title>
    <link href="/styles/tailwind.css" rel="stylesheet">
</head>
<body class="flex min-h-screen flex-col bg-gray-100">
    <div class="container mx-auto flex-1 p-6">
        <h1 class="text-3xl font-bold text-center mb-6">Tu Personalidad Financiera</h1>
        <div class="bg-white shadow-md rounded-lg p-6">
            <h2 class="text-2xl font-semibold mb-4"><%= profile.name %></h2>
            <p class="text-gray-700 mb-2"><strong>Tipo:</strong> <%= profile.label %></p>
            <% if (profile.email) { %>
                <p class="text-gray-700 mb-2"><strong>Email:</strong> <%= profile.email %></p>
            <% } %>
            <% if (profile.score !== undefined) { %>
                <p class="text-gray-700 mb-2"><strong>Puntaje principal:</strong> <%= profile.score %></p>
            <% } %>
            <p class="text-gray-700 mb-4"><strong>Descripción:</strong> <%= profile.description %></p>
            <div class="mb-4">
                <h3 class="text-xl font-semibold">Fortalezas</h3>
                <ul class="list-disc list-inside">
                    <% profile.strengths.forEach(function(strength) { %>
                        <li><%= strength %></li>
                    <% }); %>
                </ul>
            </div>
            <div>
                <h3 class="text-xl font-semibold">Oportunidades de Mejora</h3>
                <ul class="list-disc list-inside">
                    <% profile.challenges.forEach(function(challenge) { %>
                        <li><%= challenge %></li>
                    <% }); %>
                </ul>
            </div>
            <div class="mt-6">
                <a href="/" class="inline-block bg-blue-500 text-white font-semibold py-2 px-4 rounded hover:bg-blue-600">Volver a Intentarlo</a>
            </div>
        </div>
    </div>
    <cv-footer></cv-footer>
    <script src="/js/site-footer.js"></script>
</body>
</html>
