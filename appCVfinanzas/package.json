{
  "name": "cvfinanzas-results-app",
  "version": "1.0.0",
  "description": "A Node.js application to display financial personality results using Tailwind CSS.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build:css": "NODE_ENV=production tailwindcss -i ./src/styles/tailwind.css -o ./public/styles/tailwind.css",
    "importar-monex": "node scripts/importar-datos-monex.js",
    "migrar-monex": "node scripts/migrar-monex.js",
    "migrar-comentarios-tipo-cambio": "node scripts/migrar-comentarios-tipo-cambio.js",
    "upsert-user": "node scripts/upsert-user.js",
    "start": "npm run build:css && node src/server.js",
    "dev": "npm run build:css && nodemon src/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "autoprefixer": "^10.4.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.6",
    "express": "^4.17.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "postcss": "^8.4.5",
    "tailwindcss": "^2.2.19"
  },
  "devDependencies": {
    "nodemon": "^2.0.15"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
